# Environment variables — copy this file to .env and fill in your values
# NEVER commit the real .env file!

# ── ngrok ────────────────────────────────────────────────────
# Your reserved ngrok static domain
NGROK_URL=https://your-ngrok-domain.ngrok-free.dev

# ── Ollama ───────────────────────────────────────────────────
# Local Ollama model to use (must be pulled first: ollama pull mistral)
OLLAMA_MODEL=mistral

# ── FastAPI ──────────────────────────────────────────────────
# Port for the local FastAPI server
FASTAPI_PORT=8000

# ── ChromaDB ─────────────────────────────────────────────────
# Path to the ChromaDB vector database folder
CHROMA_DB_PATH=./chroma_db

# ── SQLite ───────────────────────────────────────────────────
# Path to the SQLite database for submitted applications
DB_PATH=applications.db
